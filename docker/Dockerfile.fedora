FROM fedora:latest

# Install necessary packages including full CA bundle for SSL
RUN dnf install -y ca-certificates sudo wget openssl && \
    dnf clean all

# Create a non-root user for testing
RUN useradd -m -s /bin/bash testuser
RUN echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER testuser
WORKDIR /home/testuser

CMD ["/bin/bash"]
